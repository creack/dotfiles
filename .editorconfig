root = true

[*]
end_of_line              = lf
insert_final_newline     = true
trim_trailing_whitespace = true
charset                  = utf-8
indent_style             = space
indent_size              = 2
max_line_length          = 120

[*.go]
indent_style = tab
indent_size  = 8

[*.py]
indent_size = 4

[*.md]
max_line_length          = 0
trim_trailing_whitespace = false

[{Makefile,*.mk}]
indent_style = tab
indent_size  = 8

[{Dockerfile,Dockerfile.*}]
indent_size = 4
