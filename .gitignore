# Our tracked .gitignore.global blanket-ignores .claude/ so per-project
# state doesn't bleed into random repos — but THIS repo intentionally
# vendors .claude/ content (settings, CLAUDE.md, agents, skills). Re-allow.
!.claude/
!.claude/**

# Generated by emacs / straight.el inside .emacs.d at runtime.
.emacs.d/straight/
.emacs.d/eln-cache/
.emacs.d/auto-save-list/
.emacs.d/recentf
.emacs.d/places
.emacs.d/history
.emacs.d/custom.el

# OS
.DS_Store

# tmux -v leaves these behind on lint runs.
tmux-server-*.log
tmux-client-*.log
